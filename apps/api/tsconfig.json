{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@mail-meow/background": ["../../apps/background/src"],
      "@mail-meow/background/*": ["../../apps/background/src/*"],
      "@mail-meow/backend-data": ["../../packages/backend-data/src"],
      "@mail-meow/backend-data/*": ["../../packages/backend-data/src/*"],
      "@mail-meow/backend-errors": ["../../packages/backend-errors/src"],
      "@mail-meow/backend-errors/*": ["../../packages/backend-errors/src/*"],
      "@mail-meow/backend-runtime": ["../../packages/backend-runtime/src"],
      "@mail-meow/backend-runtime/*": ["../../packages/backend-runtime/src/*"],
      "@mail-meow/backend-services": ["../../packages/backend-services/src"],
      "@mail-meow/backend-services/*": ["../../packages/backend-services/src/*"],
      "@mail-meow/provider-clients": ["../../packages/provider-clients/src"],
      "@mail-meow/provider-clients/*": ["../../packages/provider-clients/src/*"],
      "@mail-meow/shared": ["../../packages/shared/src"],
      "@mail-meow/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["../../worker-configuration.d.ts", "../../packages/backend-runtime/src/env.d.ts", "src/**/*.ts"],
  "exclude": ["test", "node_modules"]
}
