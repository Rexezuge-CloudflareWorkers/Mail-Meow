{
  "name": "mail-meow",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-spa-shell-stub.mjs",
    "dev": "vite --config vite.config.ts",
    "build": "npm run prettier && npm run lint && vite build --config vite.config.ts",
    "deploy": "npm run build && wrangler deploy --dry-run && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "test": "vitest run",
    "prettier": "prettier --write .",
    "lint": "eslint --ext .ts,.tsx --fix .",
    "tsc": "tsc --noEmit && tsc --noEmit --project tsconfig.backend.json"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "chanfana": "^3.3.0",
    "hono": "^4.12.15",
    "react": "^19.2.x",
    "react-dom": "^19.2.x",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@tailwindcss/vite": "^4.2.x",
    "@types/node": "25.6.x",
    "@types/react": "^19.2.x",
    "@types/react-dom": "^19.2.x",
    "@types/service-worker-mock": "^2.0.4",
    "@vitejs/plugin-react": "^6.0.x",
    "eslint": "^10.2.x",
    "eslint-config-prettier": "^10.1.x",
    "eslint-plugin-prettier": "^5.5.x",
    "globals": "^17.5.x",
    "jsonc-parser": "^3.3.x",
    "prettier": "^3.8.x",
    "tailwindcss": "^4.2.x",
    "terser": "^5.46.x",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.x",
    "vite": "^8.0.x",
    "vitest": "^4.1.5",
    "wrangler": "^4.86.0"
  }
}
