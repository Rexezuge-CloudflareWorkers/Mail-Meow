{
  "name": "@mail-meow/monorepo",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-spa-shell-stub.mjs && pnpm run typegen",
    "build": "pnpm -r build",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config test/integration/vitest.config.mts",
    "test:coverage:integration": "vitest run --coverage --config test/integration/vitest.config.mts",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint --fix .",
    "lint:check": "NODE_OPTIONS=--max-old-space-size=6144 eslint .",
    "typegen": "wrangler types --config ./apps/api/wrangler.template.jsonc --env-interface CloudflareEnv"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "globals": "17.13.0",
    "i18next": "^26.4.2",
    "jsdom": "^30.1.2",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@11.2.2"
}
