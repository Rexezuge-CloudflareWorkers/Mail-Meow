{
  // "$version": 1766288207,
  // "$minimumVersion": 1766030299,
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mail-meow",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-20",
  "compatibility_flags": [],
  "preview_urls": false,
  "workers_dev": true,
  "minify": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "routes": [],
  "placement": {
    "mode": "off",
  },
  "assets": {
    "directory": "./app/dist/",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "mail-meow-db",
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "AES_ENCRYPTION_KEY_SECRET",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "mail-meow-aes-encryption-key",
    },
  ],
  "vars": {
    "MAX_APPLICATIONS_PER_USER": "99",
    "MAX_API_KEYS_PER_APPLICATION": "5",
    "DEFAULT_API_KEY_EXPIRY_DAYS": "365",
    "MAX_API_KEY_EXPIRY_DAYS": "365",
    "OAUTH2_STATE_EXPIRY_MINUTES": "15",
  },
}
